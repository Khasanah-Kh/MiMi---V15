{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and learning progress stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "xp": { "type": "number" },
        "streakDays": { "type": "number" },
        "selectedEducationLevel": { "type": "string", "maxLength": 20 },
        "selectedClass": { "type": "string", "maxLength": 50 },
        "themeMode": { "type": "string", "maxLength": 20 },
        "studyMinutes": { "type": "number" },
        "lastStudiedTopic": { "type": "string", "maxLength": 200 },
        "rivalWins": { "type": "number" },
        "rivalMatches": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "DuelRoom": {
      "title": "DuelRoom",
      "description": "Real-time duel arena match document between players or bot",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "number" },
        "mode": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "maxLength": 20 },
        "host": { "type": "object" },
        "guest": { "type": "object" },
        "questions": { "type": "array" },
        "currentRound": { "type": "number" },
        "totalRounds": { "type": "number" },
        "winnerUid": { "type": "string" },
        "xpStake": { "type": "number" }
      },
      "required": ["roomId", "status", "host"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Tracks user logins, guest visits, page views, duels, quizzes, and errors",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 64 },
        "data": { "type": "object" },
        "timestamp": { "type": "string" },
        "createdAtIso": { "type": "string", "maxLength": 64 },
        "userAgent": { "type": "string", "maxLength": 500 },
        "url": { "type": "string", "maxLength": 500 }
      },
      "required": ["type"]
    },
    "UserLog": {
      "title": "UserLog",
      "description": "Aggregated user and guest login tracking record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "nama": { "type": "string", "maxLength": 120 },
        "kelas": { "type": "string", "maxLength": 60 },
        "isGuest": { "type": "boolean" },
        "lastLogin": { "type": "string" },
        "lastLoginFormatted": { "type": "string", "maxLength": 100 },
        "totalLogin": { "type": "number" },
        "device": { "type": "string", "maxLength": 50 },
        "ip": { "type": "string", "maxLength": 64 },
        "kota": { "type": "string", "maxLength": 100 }
      },
      "required": ["email", "nama"]
    },
    "ErrorReport": {
      "title": "ErrorReport",
      "description": "User-submitted or auto-caught error report notified to owner email",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 50 },
        "emailPelapor": { "type": "string", "maxLength": 150 },
        "namaPelapor": { "type": "string", "maxLength": 120 },
        "pesan": { "type": "string", "maxLength": 4000 },
        "screenshot": { "type": "string" },
        "errorStack": { "type": "string", "maxLength": 4000 },
        "url": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" },
        "createdAtIso": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "deviceInfo": { "type": "string", "maxLength": 500 }
      },
      "required": ["emailPelapor", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user learning progression and preferences"
    },
    "/duel_rooms/{roomId}": {
      "schema": "DuelRoom",
      "description": "Real-time synchronized duel room for fast cyber quiz challenges"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Stores activity logs for logins, guest sessions, duels, quizzes, and errors"
    },
    "/users_log/{userLogId}": {
      "schema": "UserLog",
      "description": "Stores cumulative login and session stats per user or guest"
    },
    "/error_reports/{reportId}": {
      "schema": "ErrorReport",
      "description": "Stores user feedback, manual bug reports, and auto-caught JS errors"
    }
  }
}
