rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Health check connection test document
    match /test/connection {
      allow get: if true;
    }

    // Users collection (supporting both Firebase Auth accounts and student guest profiles)
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Duel Arena Rooms collection for real-time multiplayer challenges
    match /duel_rooms/{roomId} {
      allow read, write: if true;
    }

    // Real-time chat messages
    match /chats/{userId}/messages/{messageId} {
      allow read, write: if isValidId(userId);
    }

    // Global Public Leaderboard
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Activity logs collection (supports logged-in and guest student telemetry + owner dashboard)
    match /activity_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Users log collection (tracks registered and guest login counts, device, IP)
    match /users_log/{userLogId} {
      allow read, write: if isValidId(userLogId);
    }

    // Error reports collection (supports manual bug reports, auto-caught errors, and owner status updates)
    match /error_reports/{reportId} {
      allow read, write: if isValidId(reportId);
    }
  }
}