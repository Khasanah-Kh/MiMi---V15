rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Health check connection test document
    match /test/connection {
      allow get: if true;
    }

    // Users collection (supporting both Firebase Auth accounts and student guest profiles)
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Duel Arena Rooms collection for real-time multiplayer challenges
    match /duel_rooms/{roomId} {
      allow read, write: if true;
    }
  }
}
